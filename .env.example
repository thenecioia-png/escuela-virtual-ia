# Supabase (capa gratuita) — copia este archivo a `.env` y pega tus keys.
# NUNCA commitees el `.env` real (ya está en .gitignore).
# Consigue las keys en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL del Worker de IA (Cloudflare Workers) — opcional hasta la Fase 3
VITE_TUTOR_API_URL=https://tu-worker.workers.dev/api/tutor
